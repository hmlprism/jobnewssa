# Supabase (from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Adzuna Jobs API (from https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Random secret string — protects the /api/jobs/ingest cron endpoint
CRON_SECRET=
