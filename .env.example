# Supabase (from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Adzuna Jobs API (from https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Random secret string — protects the /api/jobs/ingest cron endpoint
CRON_SECRET=

# Resend (https://resend.com) — for application-level transactional emails
# (reactivation request + confirmation). SEPARATE from any Resend SMTP key
# configured inside Supabase Dashboard → Auth → Email Settings.
# Without this the reactivation flow works but emails are silently skipped.
RESEND_API_KEY=
EMAIL_FROM=Job News SA <noreply@yourdomain.co.za>
